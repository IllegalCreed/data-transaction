{
  "name": "ctd-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --host --port 5200",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:5200 'cypress run --e2e --record --key c67df3a1-3ba8-4a0c-9e5c-ae280e89b02b'",
    "test:e2e:dev": "start-server-and-test 'vite dev --host --port 5200' http://localhost:5200 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/components": "^12.0.0",
    "@vueuse/core": "^12.0.0",
    "@vueuse/router": "^12.0.0",
    "async-validator": "^4.2.5",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "element-plus": "^2.9.0",
    "lodash-es": "^4.17.21",
    "pinia": "^2.3.0",
    "uuid": "^11.0.3",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "10",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.282",
    "@intlify/unplugin-vue-i18n": "^6.0.1",
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/eslint-plugin": "^1.1.16",
    "@vitest/ui": "^2.1.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "cypress": "^13.16.1",
    "eslint": "^9.16.0",
    "eslint-plugin-cypress": "^4.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "start-server-and-test": "^2.0.9",
    "typescript": "~5.6.3",
    "unocss": "^0.65.1",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-icons": "^0.21.0",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.3",
    "vite-plugin-vue-devtools": "^7.6.8",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
