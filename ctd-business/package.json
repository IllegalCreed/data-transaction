{
  "name": "ctd-business",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --host --port 5300",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:5300 'cypress run --e2e --record --key c67df3a1-3ba8-4a0c-9e5c-ae280e89b02b'",
    "test:e2e:dev": "start-server-and-test 'vite dev --host --port 5300' http://localhost:5300 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vueuse/components": "^11.2.0",
    "@vueuse/core": "^11.2.0",
    "@vueuse/router": "^11.2.0",
    "async-validator": "^4.2.5",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "element-plus": "^2.8.7",
    "lodash-es": "^4.17.21",
    "pinia": "^2.2.6",
    "uuid": "^11.0.3",
    "vue": "^3.5.12",
    "vue-i18n": "10",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.272",
    "@intlify/unplugin-vue-i18n": "^5.3.1",
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/eslint-plugin": "^1.1.10",
    "@vitest/ui": "^2.1.5",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.6.0",
    "cypress": "^13.15.2",
    "eslint": "^9.14.0",
    "eslint-plugin-cypress": "^4.1.0",
    "eslint-plugin-vue": "^9.31.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.3.3",
    "sass": "^1.81.0",
    "start-server-and-test": "^2.0.8",
    "typescript": "~5.6.3",
    "unocss": "^0.64.1",
    "unplugin-auto-import": "^0.18.4",
    "unplugin-icons": "^0.20.1",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.11",
    "vite-plugin-vue-devtools": "^7.6.4",
    "vitest": "^2.1.5",
    "vue-tsc": "^2.1.10"
  }
}
